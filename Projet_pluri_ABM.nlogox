<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="false">
  <code><![CDATA[;====================================
; Races
;====================================


breed [basiques basique]
breed [altruistes altruiste]
breed [egoistes egoiste]
breed [stocks stock]


;====================================
; Variables Own
;====================================


basiques-own [energie dernier-temps-manger type-agent sante-agent temps-malade]
altruistes-own [energie dernier-temps-manger type-agent p sante-agent temps-malade]
egoistes-own [energie dernier-temps-manger type-agent p sante-agent temps-malade]
stocks-own [quantite-nourriture sante-stocks]
patches-own [fluide]

;====================================
; Variables globales
;====================================


globals [agents]


;====================================
; Setup
;====================================

to setup
  ; Efface toute la simulation précédente
  clear-all
  
  ; Création des races
  setup-basiques
  setup-altruistes 
  setup-egoistes
  ifelse Mode = "Épidémie"
  [
    setup-stocks-epidemie
  ]
  [
    setup-stocks
  ]
  
  ask patches [set fluide 0]
  
  ; Création du groupe qui réunie tous les agents 
  set agents (turtle-set basiques altruistes egoistes)
  
  ; Remet les ticks à 0 (et réinitialise les graphiques et courbes associées).
  reset-ticks
end 

;====================================
; Go
;====================================

to go
  set agents (turtle-set basiques altruistes egoistes)
  ask agents [set dernier-temps-manger dernier-temps-manger + 1]
  mouvement-Levy
  actualise-apparence
  
  ifelse Mode = "Épidémie"
  [
    manger-stocks-epidemie
    guerison
    transmission
    reproduction-epidemie
  ]
  [
    manger-stocks  
    if Probabilite_Reproduction = "reproduction : équiprobable"
    [
      reproduction-classique-equiprobable
    ]
    if Probabilite_Reproduction = "reproduction : même type"
    [
      reproduction-classique-meme-type
    ]
    if Probabilite_Reproduction = "reproduction : loi normale"
    [
      reproduce-normal
    ]
  ]
  creation-fluide
  if ticks >= 2000 [stop]
  tick 
end

;====================================
; Setup des races 
;====================================

to setup-basiques
  create-basiques Nombre_Basiques
  [
    set color gray
    set shape "person"
    setxy random-xcor random-ycor
    set energie Energie_Initiale_Parents
    set dernier-temps-manger 0
    set type-agent 1
    set sante-agent 0
  ]
end

to setup-altruistes
  create-altruistes Nombre_Altruistes
  [
    set color blue
    set shape "person"
    setxy random-xcor random-ycor
    set energie Energie_Initiale_Parents
    set dernier-temps-manger 0
    set p random-float 0.5 + 0.5
    set type-agent 2
    set sante-agent 0
  ]
end

to setup-egoistes
  create-egoistes Nombre_Egoistes
  [
    set color red
    set shape "person"
    setxy random-xcor random-ycor
    set energie Energie_Initiale_Parents
    set dernier-temps-manger 0
    set p random-float 0.5 + 0.5
    set type-agent 3
    set sante-agent 0
  ]
end

to setup-stocks
  create-stocks Stock_De_Nourritures
  [
    set color yellow
    set color [color] of self - 2
    set shape "circle"
    set quantite-nourriture 100
    set size 0.4 + 0.05 * quantite-nourriture	
    setxy random-xcor random-ycor
  ]
end


;=================================
; Fonction move : Mouvement Levy
;=================================
to mouvement-Levy
  ask agents
  [
    ifelse is-basique? self
    [
      rt random 40
    	lt random 40
      ifelse sante-agent = 1
      [
        	fd 0.5
        	set energie energie - 1.5 
      ]
      [
        fd 1
        set energie energie - 1
      ]
    	if energie <= 0 [die]   
    ]
    [
      ifelse (fluide > 0.01)
      [
        suivre-fluide
        fd 1
        set energie energie - 1
        if energie <= 0 [die]
      ]
      [
        rt random 40
        lt random 40
        ifelse sante-agent = 1
        [
          fd 0.5
          set energie energie - 1.5
        ]
        [
          fd 1
          set energie energie - 1 
        ]
        if energie <= 0 [die]
      ]
    ]
  ]
end


;==================================
; Fonction : Manger + Apparence stock
;==================================


to manger-stocks
  ; liste des stocks vides
  let stocks-vide[] 
  
  ask agents
  [
    ; on attend au moins 2 ticks avant de pouvoir manger à nouveau
    if dernier-temps-manger > 2
    [
      let stock-proche one-of stocks in-radius 1
      if stock-proche != nobody
      [
        ;Gain d'énergie lorsqu'un agent mange
        set energie energie + Gain_Energie_Par_Nourriture
        set dernier-temps-manger 0
        
        if Taux_Energie_Creation_Fluide < energie
        [
          if is-altruiste? self[ set fluide fluide + 50 set energie energie - Cout_Energie_Creation_Fluide]
        ]
        
        ; Diminue la quantité de nourriture 
        ask stock-proche
        [
          set quantite-nourriture quantite-nourriture - 1
          if quantite-nourriture <= 0
          [
            set stocks-vide lput self stocks-vide
            die
          ]
        ]
      ]
    ]
  ]

  ; Recréer les stocks lorsque consommés
  foreach stocks-vide
  [
    create-stocks 1
    [
      set color yellow
      set color [color] of self - 2
      set shape "circle"
      set quantite-nourriture 100
      set size 0.4 + 0.05 * quantite-nourriture
      setxy random-xcor random-ycor
    ]
  ]
end


; Actualise l'apparence du stock de nourriture 
to actualise-apparence
  ask stocks
  [
    set size 0.4 + 0.05 * quantite-nourriture
  ]
end


;========================================
; Fonction : Reproduction 
;========================================
 

to reproduction-classique-equiprobable
  ask agents
  [
    if Energie >= Taux_Energie_Pour_Se_Reproduire
    [
      ifelse type-agent = 1
      [
        hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1 set sante-agent 0]
      ]
      [
        let r random 2
        if r = 0 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2 set sante-agent 0]]
        if r = 1 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3 set sante-agent 0]]
      ]
      set energie energie - Cout_Energie_Reproduction
    ]
  ]
end


to reproduction-classique-meme-type
  ask agents
  [
    if Energie >= Taux_Energie_Pour_Se_Reproduire
    [
      if type-agent = 1 [hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1 set sante-agent 0]]
      if type-agent = 2 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2 set sante-agent 0]]
      if type-agent = 3 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3 set sante-agent 0]]
      set energie energie - Cout_Energie_Reproduction
    ]
  ]
end


to heritier-mutation-normale  
  let type-parent type-agent
  let p-parent p
  
  let p-enfant p-parent + random-normal 0 0.03
  set p-enfant max list 0.5 min list 1 p-enfant
  
  let type-enfant type-parent
  ; Décision héritée ou mutée
  ifelse random-float 1.0 < p
  [
    set type-enfant type-parent
  ]
  [
    ifelse type-parent = 2
    [ set type-enfant 3 ]
    [ set type-enfant 2 ]
  ]

  ; Naissance : UN SEUL HATCH
  ifelse sante-agent = 1
  [
    ifelse type-enfant = 2
    [
      hatch-altruistes 1 [ set color blue set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set p p-enfant set type-agent 2
        ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]
    ]
    [
      hatch-egoistes 1 [ set color red set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set p p-enfant set type-agent 3
        ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]
    ]
  ]
  [
    ifelse type-enfant = 2
    [
      hatch-altruistes 1 [ set color blue set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set p p-enfant set type-agent 2 set sante-agent 0]
    ]
    [
        hatch-egoistes 1 [ set color red set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set p p-enfant set type-agent 3 set sante-agent 0]
    ]
  ]
end


to reproduce-normal
  ask agents
  [
    if energie >= Taux_Energie_Pour_Se_Reproduire
    [
      ifelse type-agent = 1
      [
        hatch-basiques 1 [ set color gray set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set type-agent 1]
      ]
      [
        heritier-mutation-normale
      ]
      set energie energie - Cout_Energie_Reproduction
    ]
  ]
end

;============================
; Fonctions : Fluide + Suivi du Fluide + Création fluide
;============================


to suivre-fluide  
  let odeur-devant sent-odeur-angle 0
  let odeur-gauche sent-odeur-angle -45
  let odeur-droite sent-odeur-angle 45
  
  if (odeur-droite > odeur-devant) or (odeur-gauche > odeur-devant)
  [
    ifelse odeur-droite > odeur-gauche
    [rt 45]
    [lt 45]
  ]
end


to-report sent-odeur-angle [angle]
  let pa patch-right-and-ahead angle 1
  if pa = nobody [ report 0 ]
  report [fluide] of pa
end


to creation-fluide
  diffuse fluide 0.8
  ask patches
  [
    set fluide fluide * 0.9 
    if fluide < 0.001 [ set fluide 0]
    if fluide > 0.1 [ set pcolor scale-color violet fluide 0.1 5]
  ]
end


;========================
; Épidémie
;========================


to setup-stocks-epidemie
  create-stocks Stock_De_Nourritures
  [
    
    set shape "circle"
    set quantite-nourriture 100
    set size 0.4 + 0.05 * quantite-nourriture	
    setxy random-xcor random-ycor
    ifelse random-float 1 > 0.7
    [
      set sante-stocks 1
      set color green 
      set color [color] of self - 2 
    ]
    [
      set sante-stocks 0 
      set color yellow
      set color [color] of self - 2
    ]
  ]
end


to manger-stocks-epidemie
   ; liste des stocks vides
  let stocks-vide[] 
  
  ask agents
  [
    ; on attend au moins 2 ticks avant de pouvoir manger à nouveau
    if dernier-temps-manger > 2
    [
      let stock-proche one-of stocks in-radius 1
      if stock-proche != nobody
      [
        if ([sante-stocks] of stock-proche = 1)
        [
          if random-float 1 < 0.3
          [
            set sante-agent 1
            set color green 
          ]
        ]
        
        ;Gain d'énergie lorsqu'un agent mange
        set energie energie + Gain_Energie_Par_Nourriture
        set dernier-temps-manger 0
        
        if Taux_Energie_Creation_Fluide < energie
        [
          if is-altruiste? self[ set fluide fluide + 50 set energie energie - Cout_Energie_Creation_Fluide]
        ]

        ; Diminue la quantité de nourriture 
        ask stock-proche
        [
          set quantite-nourriture quantite-nourriture - 1
          if quantite-nourriture <= 0
          [
            set stocks-vide lput self stocks-vide
            die
          ]
        ]
      ]
    ]
  ]

  ; Recréer les stocks lorsque consommés
  foreach stocks-vide
  [
    create-stocks 1
    [
   set shape "circle"
    set quantite-nourriture 100
    set size 0.4 + 0.05 * quantite-nourriture	
    setxy random-xcor random-ycor
    ifelse random-float 1 > 0.7
    [
      set sante-stocks 1
      set color green 
      set color [color] of self - 2 
    ]
    [
      set sante-stocks 0 
      set color yellow
      set color [color] of self - 2
    ]
    ]
  ]
end 


to guerison
  ask agents with [sante-agent = 1]
  [
    if random-float 1 < 0.1
    [
      set sante-agent 0 
      if type-agent = 1 [set color gray]
      if type-agent = 2 [set color blue]
      if type-agent = 3 [set color red]
      set temps-malade 3
    ]
  ]
end


to contamination-contact[agent-contact proba]
  if sante-agent = 0 and [sante-agent] of agent-contact = 1
  [
    if temps-malade >= 3
    [
      if random-float 1 < proba [set sante-agent 1 set temps-malade 0 set color green]
    ]
  ]
end


to transmission
  ask agents with [sante-agent = 0]
  [
    let proche-malade one-of other agents in-radius 1 with [sante-agent = 1]
    if proche-malade != nobody 
    [
      contamination-contact proche-malade 0.4
    ]
  ]
end



to reproduction-epidemie
  if Probabilite_Reproduction = "reproduction : équiprobable"
  [
    ask agents
    [
      if Energie >= Taux_Energie_Pour_Se_Reproduire 
      [
        ifelse type-agent = 1
        [
          ifelse sante-agent = 1
          [
            hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1
              ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]
          ]
          [
            hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1 set sante-agent 0]
          ]
        ]
        [
          let r random 2
          ifelse sante-agent = 1
          [
            if r = 0 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2
              ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]]
            if r = 1 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3
              ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]]
          ]
          [
            if r = 0 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2 set sante-agent 0]]
            if r = 1 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3 set sante-agent 0]]
          ]
        ]
        set energie energie - Cout_Energie_Reproduction
      ]
    ]
  ]
  if Probabilite_Reproduction = "reproduction : même type"
  [
    ask agents
    [
      if Energie >= Taux_Energie_Pour_Se_Reproduire
      [
        ifelse sante-agent = 1
        [
          if type-agent = 1 [hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1
            ifelse random-float 1 < 0.3 [set sante-agent 1 ][set sante-agent 0]]]
          if type-agent = 2 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2
            ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]]
          if type-agent = 3 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3
            ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]]
        ]
        [
          if type-agent = 1 [hatch-basiques 1 [set color gray set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 1 set sante-agent 0]]
          if type-agent = 2 [hatch-altruistes 1 [set color blue set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 2 set sante-agent 0]]
          if type-agent = 3 [hatch-egoistes 1 [set color red set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set dernier-temps-manger 0 set type-agent 3 set sante-agent 0]]
        ]
        set energie energie - Cout_Energie_Reproduction
      ]
    ]
  ]
  if Probabilite_Reproduction = "reproduction : loi normale"
  [
    ask agents
    [
      if energie >= Taux_Energie_Pour_Se_Reproduire
      [
        ifelse type-agent = 1
        [
          ifelse sante-agent = 1
          [
            hatch-basiques 1 [ set color gray set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set type-agent 1
              ifelse random-float 1 < 0.3 [set sante-agent 1][set sante-agent 0]]
          ]
          [
            hatch-basiques 1 [ set color gray set dernier-temps-manger 0 set shape "person" setxy random-xcor random-ycor set energie Energie_Enfants set type-agent 1 set sante-agent 0]
          ]
        ]
        [
          heritier-mutation-normale
        ]
         set energie energie - Cout_Energie_Reproduction
      ]
    ]
  ]
end
]]></code>
  <widgets>
    <view x="768" wrappingAllowedX="true" y="8" frameRate="90.0" minPycor="-16" height="684" showTickCounter="true" patchSize="20.61" fontSize="10" wrappingAllowedY="true" width="684" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <note x="7" y="9" backgroundDark="0" fontSize="16" width="757" markdown="false" height="31" textColorDark="-1" textColorLight="-16777216" backgroundLight="-5987164">                                                             Projet Pluridisciplinaire ~ ABM : Altruism</note>
    <button x="6" y="110" height="60" disableUntilTicks="false" forever="true" kind="Observer" width="254">go</button>
    <chooser x="265" y="110" height="60" variable="Mode" current="0" width="497" display="Mode">
      <choice type="string" value="Classique"></choice>
      <choice type="string" value="Épidémie"></choice>
    </chooser>
    <button x="7" y="45" height="60" disableUntilTicks="false" forever="false" kind="Observer" width="253">setup</button>
    <chooser x="265" y="45" height="60" variable="Probabilite_Reproduction" current="1" width="497" display="Probabilite_Reproduction">
      <choice type="string" value="reproduction : équiprobable"></choice>
      <choice type="string" value="reproduction : même type"></choice>
      <choice type="string" value="reproduction : loi normale"></choice>
    </chooser>
    <slider x="514" step="1" y="320" max="100" width="248" display="Cout_Energie_Creation_Fluide" height="50" min="0" direction="Horizontal" default="15.0" variable="Cout_Energie_Creation_Fluide"></slider>
    <slider x="515" step="1" y="265" max="100" width="248" display="Gain_Energie_Par_Nourriture" height="50" min="0" direction="Horizontal" default="40.0" variable="Gain_Energie_Par_Nourriture"></slider>
    <slider x="5" step="1" y="210" max="100" width="250" display="Nombre_Altruistes" height="50" min="0" direction="Horizontal" default="38.0" variable="Nombre_Altruistes"></slider>
    <slider x="5" step="1" y="265" max="100" width="250" display="Nombre_Egoistes" height="50" min="0" direction="Horizontal" default="0.0" variable="Nombre_Egoistes"></slider>
    <slider x="5" step="1" y="320" max="100" width="250" display="Nombre_Basiques" height="50" min="0" direction="Horizontal" default="0.0" variable="Nombre_Basiques"></slider>
    <slider x="260" step="1" y="265" max="100" width="250" display="Taux_Energie_Pour_Se_Reproduire" height="50" min="0" direction="Horizontal" default="70.0" variable="Taux_Energie_Pour_Se_Reproduire"></slider>
    <slider x="513" step="1" y="212" max="10" width="250" display="Stock_De_Nourritures" height="50" min="0" direction="Horizontal" default="6.0" variable="Stock_De_Nourritures"></slider>
    <slider x="260" step="1" y="320" max="100" width="250" display="Cout_Energie_Reproduction" height="50" min="0" direction="Horizontal" default="40.0" variable="Cout_Energie_Reproduction"></slider>
    <slider x="5" step="1" y="375" max="100" width="250" display="Energie_Enfants" height="50" min="0" direction="Horizontal" default="50.0" variable="Energie_Enfants"></slider>
    <slider x="260" step="1" y="375" max="100" width="250" display="Taux_Energie_Creation_FLuide" height="50" min="0" direction="Horizontal" default="30.0" variable="Taux_Energie_Creation_FLuide"></slider>
    <slider x="260" step="1" y="210" max="100" width="250" display="Energie_Initiale_Parents" height="50" min="0" direction="Horizontal" default="50.0" variable="Energie_Initiale_Parents"></slider>
    <plot x="7" autoPlotX="true" yMax="10.0" autoPlotY="true" y="429" xMin="0.0" height="263" legend="true" xMax="10.0" yMin="0.0" width="758" display="Évolution des populations au cours du temps">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Basiques" color="-7500403" legend="true">
        <setup></setup>
        <update>plot count basiques</update>
      </pen>
      <pen interval="1.0" mode="0" display="Altruistes" color="-13345367" legend="true">
        <setup></setup>
        <update>plot count altruistes</update>
      </pen>
      <pen interval="1.0" mode="0" display="Égoïstes" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count egoistes</update>
      </pen>
      <pen interval="1.0" mode="0" display="Malades" color="-13840069" legend="true">
        <setup></setup>
        <update>plot count agents with [sante-agent = 1]</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-4" color="-1184463" legend="true">
        <setup></setup>
        <update>plot count agents</update>
      </pen>
    </plot>
    <note x="4" y="176" backgroundDark="0" fontSize="16" width="759" markdown="false" height="31" textColorDark="-1" textColorLight="-16777216" backgroundLight="-5987164">                                                                                  Paramètres</note>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

